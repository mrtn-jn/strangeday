# Ignore everything at the WordPress site root by default.
/*

# Keep repository metadata and project docs.
!/.gitignore
!/docs/
!/docs/**

# Keep only the custom Strangeday theme from wp-content.
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/strangeday/
!/wp-content/themes/strangeday/**
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/strangeday-core/
!/wp-content/plugins/strangeday-core/**

# Ignore local/build artifacts inside the theme.
/wp-content/themes/strangeday/node_modules/
/wp-content/themes/strangeday/vendor/
/wp-content/plugins/strangeday-core/vendor/

# OS/editor noise.
.DS_Store
Thumbs.db
